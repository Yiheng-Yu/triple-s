<?xml version='1.0' encoding='utf-8'?>
<sss version="2.0">
  <date>10 November 2026</date>
  <origin>Stack Overflow 2026 public dataset: derived Triple-S XML 2.0 conversion</origin>
  <survey>
    <name>SO2026</name>
    <title>Stack Overflow Developer Survey 2026 (converted public responses)</title>
    <record ident="R" format="csv" skip="1" href="stackoverflow_2026.csv">
      <variable ident="1" type="quantity" use="serial">
        <name>ResponseId</name>
        <label>Sequential public respondent identifier; not the internal Qualtrics ID.</label>
        <position start="1" />
        <values>
          <range from="1" to="30903" />
        </values>
      </variable>
      <variable ident="2" type="single">
        <name>Age</name>
        <label>What is your age?</label>
        <position start="2" />
        <values>
          <value code="1">Under 18 years old</value>
          <value code="2">18-24 years old</value>
          <value code="3">25-34 years old</value>
          <value code="4">35-44 years old</value>
          <value code="5">45-54 years old</value>
          <value code="6">55-64 years old</value>
          <value code="7">65 years or older</value>
          <value code="8">Prefer not to say</value>
        </values>
      </variable>
      <variable ident="3" type="single">
        <name>CodeMain</name>
        <label>Are you someone who creates code? Please select one of the following options that best describes you today.</label>
        <position start="3" />
        <values>
          <value code="1">I create code as a primary part of my job</value>
          <value code="2">I create code occasionally</value>
          <value code="3">I review/maintain code but rarely create it</value>
          <value code="4">I manage or support people who create code</value>
          <value code="5">I do not create code</value>
          <value code="6">NA</value>
        </values>
      </variable>
      <variable ident="4" type="single">
        <name>Education</name>
        <label>Which of the following best describes the highest level of formal education that you've completed?</label>
        <position start="4" />
        <values>
          <value code="1">Primary/elementary school</value>
          <value code="2">Secondary school (e.g. American high school, German Realschule or Gymnasium, etc.)</value>
          <value code="3">Some college/university study without earning a degree</value>
          <value code="4">Associate degree (A.A., A.S., etc.)</value>
          <value code="5">Bachelor's degree (B.A., B.S., B.Eng., etc.)</value>
          <value code="6">Master's degree (M.A., M.S., M.Eng., MBA, etc.)</value>
          <value code="7">Professional degree (JD, MD, Ph.D, Ed.D, etc.)</value>
          <value code="8">Other, please specify</value>
          <value code="9">NA</value>
        </values>
      </variable>
      <variable ident="5" type="single">
        <name>Employment</name>
        <label>Which of the following best describes your current employment status?</label>
        <position start="5" />
        <values>
          <value code="1">Employed</value>
          <value code="2">Independent contractor, freelancer, or self-employed</value>
          <value code="3">Not employed</value>
          <value code="4">Student</value>
          <value code="5">Retired</value>
          <value code="6">I prefer not to say</value>
        </values>
      </variable>
      <variable ident="6" type="multiple">
        <name>EmploymentAddl</name>
        <label>Which of the following other current work, school, or life responsibilities are you currently engaged in?</label>
        <position start="6" />
        <values>
          <value code="1">Attending school (full-time)</value>
          <value code="2">Attending school (part-time)</value>
          <value code="3">Engaged in paid work (less than 10 hours per week)</value>
          <value code="4">Engaged in paid work (10-19 hours per week)</value>
          <value code="5">Engaged in paid work (20-29 hours per week)</value>
          <value code="6">Transitioning to retirement (gradually reducing work hours)</value>
          <value code="7">Volunteering (regularly)</value>
          <value code="8">Caring for dependents (children, elderly, etc.)</value>
          <value code="9">None of the above</value>
          <value code="10">NA</value>
        </values>
      </variable>
      <variable ident="7" type="single">
        <name>ICorPM</name>
        <label>Are you an individual contributor or people manager?</label>
        <position start="7" />
        <values>
          <value code="1">Individual contributor</value>
          <value code="2">People manager</value>
          <value code="3">Individual contributor in a senior or staff-level role</value>
          <value code="4">Both people manager and individual contributor</value>
          <value code="5">NA</value>
        </values>
      </variable>
      <variable ident="8" type="single">
        <name>WorkSetting</name>
        <label>Which best describes your current work situation?</label>
        <position start="8" />
        <values>
          <value code="1">Remote</value>
          <value code="2">In-person</value>
          <value code="3">Hybrid (some remote, leans heavy to in-person)</value>
          <value code="4">Hybrid (some in-person, leans heavy to flexibility)</value>
          <value code="5">Your choice (very flexible, you can come in when you want or just as needed)</value>
          <value code="6">NA</value>
        </values>
      </variable>
      <variable ident="9" type="single">
        <name>LearnCode</name>
        <label>Did you begin learning to code or learn a new coding skill or programming language in the last year?</label>
        <position start="9" />
        <values>
          <value code="1">NA</value>
          <value code="2">No</value>
          <value code="3">Yes</value>
        </values>
      </variable>
      <variable ident="10" type="multiple">
        <name>LearnCodeHow</name>
        <label>How did you learn to code in the past year? Select all that apply.</label>
        <position start="10" />
        <values>
          <value code="1">Books / physical media</value>
          <value code="2">Technical documentation (is generated for/by the tool or system)</value>
          <value code="3">Coding bootcamp</value>
          <value code="4">Colleague or on-the-job training</value>
          <value code="5">Games or coding challenges</value>
          <value code="6">Blogs or podcasts</value>
          <value code="7">Other online resources (e.g. standard search, forum, online community)</value>
          <value code="8">School (i.e., university, college, etc)</value>
          <value code="9">Stack Overflow or Stack Exchange</value>
          <value code="10">Other, please specify</value>
          <value code="11">AI codegen tools or AI-enabled apps</value>
          <value code="12">NA</value>
          <value code="13">Online courses or certification (includes all media types)</value>
          <value code="14">Videos (not associated with specific online course or certification)</value>
        </values>
      </variable>
      <variable ident="11" type="single">
        <name>LearnAI</name>
        <label>In the last year, did you spend time learning AI programming or AI-enabled tooling on your own or at work?</label>
        <position start="11" />
        <values>
          <value code="1">Yes, on my own</value>
          <value code="2">Yes, at work</value>
          <value code="3">Yes, both on my own and at work</value>
          <value code="4">NA</value>
          <value code="5">No</value>
        </values>
      </variable>
      <variable ident="12" type="multiple">
        <name>LearnAIHow</name>
        <label>How did you learn to code for AI in the past year? Select all that apply.</label>
        <position start="12" />
        <values>
          <value code="1">Books / Physical media</value>
          <value code="2">Technical documentation (is generated for/by the tool or system)</value>
          <value code="3">Coding Bootcamp</value>
          <value code="4">Colleague or on-the-job training</value>
          <value code="5">Games or coding challenges</value>
          <value code="6">Online Courses or Certification (includes all media types)</value>
          <value code="7">AI CodeGen tools or AI-enabled apps</value>
          <value code="8">Blogs or podcasts</value>
          <value code="9">Videos (not associated with specific online course or certification)</value>
          <value code="10">Other online resources (e.g. standard search, forum, online community)</value>
          <value code="11">School (i.e., University, College, etc)</value>
          <value code="12">Stack Overflow or Stack Exchange</value>
          <value code="13">Other, please specify</value>
          <value code="14">NA</value>
        </values>
      </variable>
