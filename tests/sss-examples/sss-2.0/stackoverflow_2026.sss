          <value code="20">Software development</value>
          <value code="21">Transportation or supply chain</value>
          <value code="22">Utilities, internet, or telecommunications</value>
          <value code="23">Other, please specify</value>
          <value code="24">NA</value>
        </values>
      </variable>
      <variable ident="21" type="character">
        <name>JobSat</name>
        <label>How satisfied are you in your current professional role?</label>
        <position start="21" />
        <size>2</size>
      </variable>
      <variable ident="22" type="single">
        <name>JobSatComplacent</name>
        <label>If you feel complacent at work, what is the primary driver?</label>
        <position start="22" />
        <values>
          <value code="1">Lack of upward mobility due to corporate tightening</value>
          <value code="2">AI automating the challenging parts of my job</value>
          <value code="3">Economic uncertainty making me hesitant to switch roles</value>
          <value code="4">Burnout/tech fatigue</value>
          <value code="5">I do not feel complacent</value>
          <value code="6">Other, please specify</value>
          <value code="7">NA</value>
        </values>
      </variable>
      <variable ident="23" type="single">
        <name>JobEase</name>
        <label>In the past 6 months, which factor has done the most to make your job easier to do?</label>
        <position start="23" />
        <values>
          <value code="1">Clear priorities or requirements</value>
          <value code="2">Access to the right tools or platforms</value>
          <value code="3">Reliable systems, infrastructure, or environments</value>
          <value code="4">Helpful documentation or knowledge sharing</value>
          <value code="5">Supportive teammates, managers, or mentors</value>
          <value code="6">Enough time, staffing, or resources</value>
          <value code="7">Leadership activity or organizational changes</value>
          <value code="8">Better processes, workflows, or coordination</value>
          <value code="9">Nothing has made my job easier in the past 6 months</value>
          <value code="10">I’m not sure</value>
          <value code="11">Other, please specify</value>
          <value code="12">NA</value>
        </values>
      </variable>
      <variable ident="24" type="single">
        <name>JobEaseAI_1</name>
        <label>For each factor that made your job easier, was AI or AI agents a reason?</label>
        <position start="24" />
        <values>
          <value code="1">I’m not sure</value>
          <value code="2">NA</value>
          <value code="3">No, AI or AI agents were not a reason</value>
          <value code="4">Yes, AI or AI agents contributed, but were not the main reason</value>
          <value code="5">Yes, AI or AI agents were the main reason</value>
        </values>
      </variable>
      <variable ident="25" type="single">
        <name>JobEaseAI_2</name>
        <label>For each factor that made your job easier, was AI or AI agents a reason?</label>
        <position start="25" />
        <values>
          <value code="1">I’m not sure</value>
          <value code="2">NA</value>
          <value code="3">No, AI or AI agents were not a reason</value>
          <value code="4">Yes, AI or AI agents contributed, but were not the main reason</value>
          <value code="5">Yes, AI or AI agents were the main reason</value>
