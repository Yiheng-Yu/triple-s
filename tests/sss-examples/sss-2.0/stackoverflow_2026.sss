      <variable ident="16" type="multiple">
        <name>RoleFunctions</name>
        <label>In a typical week, which of the following activities are part of your work? Select all that apply.</label>
        <position start="16" />
        <values>
          <value code="1">Writing, editing, or generating code</value>
          <value code="2">Debugging or troubleshooting</value>
          <value code="3">Reviewing code, pull requests, or technical changes</value>
          <value code="4">Writing or maintaining tests</value>
          <value code="5">Writing or updating documentation</value>
          <value code="6">Making technical design or architecture decisions</value>
          <value code="7">Planning, scoping, or estimating work</value>
          <value code="8">Changing production code, systems, or infrastructure</value>
          <value code="9">Deploying or releasing software</value>
          <value code="10">Monitoring systems, logs, metrics, or alerts</value>
          <value code="11">Investigating an incident, outage, or production issue</value>
          <value code="12">Maintaining dependencies, packages, or development environments</value>
          <value code="13">Finding or fixing security, privacy, or compliance issues</value>
          <value code="14">Analyzing data, reports, or business metrics</value>
          <value code="15">Onboarding to a new project, tool, system, or codebase</value>
          <value code="16">Answering questions from teammates, customers, users, or stakeholders</value>
          <value code="17">Coordinating work across teams or functions</value>
          <value code="18">None of the above</value>
          <value code="19">NA</value>
        </values>
      </variable>
      <variable ident="17" type="single">
        <name>OrgSize</name>
        <label>Approximately how many people are employed by your employer? This should only include your primary company. If you had more than one employer, please consider the one you spent most of your time working for in the past year.</label>
        <position start="17" />
        <values>
          <value code="1">Just me - I am a freelancer, sole proprietor, etc.</value>
          <value code="2">Less than 20 employees</value>
          <value code="3">20 to 99 employees</value>
          <value code="4">100 to 499 employees</value>
          <value code="5">500 to 999 employees</value>
          <value code="6">1,000 to 4,999 employees</value>
          <value code="7">5,000 to 9,999 employees</value>
          <value code="8">10,000 or more employees</value>
          <value code="9">I don’t know</value>
          <value code="10">NA</value>
        </values>
      </variable>
      <variable ident="18" type="single">
        <name>TechBudget</name>
        <label>Has your department's budget increased, decreased, or stayed the same in your most recent budget cycle? When considering your department, refer to the one you are working in today.</label>
        <position start="18" />
        <values>
          <value code="1">Increased</value>
          <value code="2">Decreased</value>
          <value code="3">Stayed the same</value>
          <value code="4">I don't know</value>
          <value code="5">NA</value>
        </values>
      </variable>
      <variable ident="19" type="multiple">
        <name>PurchasePower</name>
        <label>Which of the following describes your role in choosing or using software tools at your organization? Select all that apply.</label>
        <position start="19" />
        <values>
          <value code="1">I make the final decision to purchase tools</value>
          <value code="2">I approve or manage budget for tools</value>
          <value code="3">I evaluate, recommend, or shortlist tools</value>
          <value code="4">I influence tool choices by giving feedback or requirements</value>
          <value code="5">I use tools selected by others</value>
          <value code="6">I do not have a role in choosing or using software tools at my organization</value>
          <value code="7">NA</value>
        </values>
      </variable>
      <variable ident="20" type="single">
        <name>Industry</name>
        <label>What industry is the company you work for in?</label>
        <position start="20" />
        <values>
          <value code="1">Agriculture, forestry, fishing, and hunting</value>
          <value code="2">Banking/financial services</value>
          <value code="3">Broadcasting or publishing</value>
          <value code="4">Education</value>
