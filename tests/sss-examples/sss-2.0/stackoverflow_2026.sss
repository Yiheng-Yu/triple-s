      <variable ident="15" type="single">
        <name>Role</name>
        <label>Which of the following best describes your current role, or the role you held for the most time in the past year?</label>
        <position start="15" />
        <values>
          <value code="1">Academic researcher</value>
          <value code="2">AI/ML engineer</value>
