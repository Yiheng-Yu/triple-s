          <value code="13">Life sciences or biotechnology</value>
          <value code="14">Manufacturing</value>
          <value code="15">Media or advertising services</value>
          <value code="16">Mining or construction</value>
          <value code="17">Non-profit or social services</value>
          <value code="18">Retail, e-commerce, or consumer services</value>
