      <variable ident="206" type="multiple">
        <name>TrustReason</name>
        <label>When deciding whether to rely on work-related information, which signals matter most to you? Select up to 5.</label>
        <position start="206" />
        <values>
          <value code="1">It is recent or clearly up to date</value>
          <value code="2">It is marked final, approved, accepted, or official</value>
          <value code="3">It is not marked draft, outdated, deprecated, or superseded</value>
          <value code="4">I know who created or owns it</value>
          <value code="5">It comes from an official or trusted source</value>
          <value code="6">It was reviewed or validated by a subject matter expert</value>
          <value code="7">It includes sources, citations, links, or supporting evidence</value>
          <value code="8">It is consistent with other trusted information</value>
          <value code="9">Other people on my team use or endorse it</value>
          <value code="10">It is clear, complete, and easy to understand</value>
          <value code="11">It respects access, privacy, or permission rules</value>
          <value code="12">None of these</value>
          <value code="13">Not sure</value>
          <value code="14">NA</value>
        </values>
      </variable>
