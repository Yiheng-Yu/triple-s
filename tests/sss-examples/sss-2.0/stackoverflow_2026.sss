          <value code="6">Yes, I am more selective about tasks</value>
          <value code="7">No, cost/limits have not affected my usage</value>
          <value code="8">My company/team has increased budget for AI</value>
          <value code="9">I have not encountered cost or usage limits</value>
          <value code="10">Not sure</value>
          <value code="11">NA</value>
        </values>
      </variable>
